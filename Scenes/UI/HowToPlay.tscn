[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/UI/HowToPlay.cs" id="1_help"]

[node name="HowToPlay" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_help")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Panel/Rows"]
theme_type_variation = &"HeaderMedium"
layout_mode = 2
text = "HELP_TITLE"
horizontal_alignment = 1

[node name="Text" type="RichTextLabel" parent="Center/Panel/Rows"]
custom_minimum_size = Vector2(720, 440)
layout_mode = 2
bbcode_enabled = true
scroll_following = false

[node name="Back" type="Button" parent="Center/Panel/Rows"]
layout_mode = 2
text = "UI_BACK"
