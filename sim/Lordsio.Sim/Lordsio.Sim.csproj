<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure game rules. Must not reference Godot: it is shared by the game and the NUnit tests. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lordsio.Sim</RootNamespace>
    <!-- Godot builds referenced projects with its own configuration names. -->
    <Optimize Condition=" '$(Configuration)' == 'ExportRelease' ">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lordsio.Sim.Tests" />
  </ItemGroup>

</Project>
